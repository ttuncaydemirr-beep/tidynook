<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts (light). Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started; also the window colour behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
</resources>
